<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusflow.mapper.EmpExprMapper">


    <!--批量保存员工的工作经历
    foreach标签:
        collection: 遍历的集合
        item: 遍历出的元素
        separator: 每次循环之间的分隔符

    -->

    <!-- 
        insert into emp_expr(emp_id, begin, end, company, job) values
        (1, '2020-01-01', '2022-01-01', '公司1', '岗位1'),
        (2, '2022-01-01', '2024-01-01', '公司2', '岗位2'),
        (3, '2024-01-01', '2026-01-01', '公司3', '岗位3');
     -->
    <insert id="insertBatch">
        insert into emp_expr(emp_id, begin, end, company, job) values
        <foreach collection="exprs" item="expr" separator="," >     <!-- 遍历exprs集合，每个元素为expr,','为间隔 -->
            (#{expr.empId},#{expr.begin},#{expr.end},#{expr.company},#{expr.job})
        </foreach>
    </insert>




    <!-- 
        delete from emp_expr where emp_id in (1, 2, 3);
     -->
    <delete id="deleteByEmpIds">
        delete from emp_expr where emp_id in
        <foreach collection="empIds" item="empId" separator="," open="(" close=")">
            #{empId}
        </foreach>
    </delete>


    <!-- 
        select *
        from emp_expr
        where emp_id=#{id}
     -->
    <select id="getByEmpId" resultType="com.campusflow.pojo.EmpExpr">
        select *
        from emp_expr
        where emp_id=#{id}
    </select>

</mapper>